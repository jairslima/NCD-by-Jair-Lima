{
  "name": "ncd-by-jair-lima",
  "version": "1.0.0",
  "description": "NCD - New Change Directory. Visual directory tree navigator inspired by Norton's classic NCD utility.",
  "main": "dist/index.js",
  "bin": {
    "ncd": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "node dist/postinstall.js 2>/dev/null || true"
  },
  "keywords": ["ncd", "cli", "directory", "navigator", "tui", "norton"],
  "author": "Jair Lima",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
